# Hotel Booking API - Docker Backend Environment
# Copy this file to .env.docker and fill in your actual values
# This is used when the backend runs inside a Docker container

# Database Configuration
# When backend runs in Docker, use the Docker service name 'mysql' instead of localhost
DATABASE_URL=mysql://appuser:apppass@mysql:3306/final_project_db

# JWT Configuration
# Generate a secure random string for this value (at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=3000
NODE_ENV=production

# Redis Configuration
# When backend runs in Docker, use the Docker service name 'redis' instead of localhost
REDIS_HOST=redis
REDIS_PORT=6379

# Optional: Logging Level
LOG_LEVEL=info
