# Hotel Booking System - Docker Compose Infrastructure Configuration
# Copy this file to .env and fill in your actual values
# This file is used by docker-compose.yml to configure MySQL and other services

# Database Configuration
# Must match the app/.env.docker values
DATABASE_URL=mysql://appuser:apppass@mysql:3306/final_project_db

# MySQL Root Password
# This is only used during MySQL container initialization
MYSQL_ROOT_PASSWORD=rootpass

# MySQL Database Name
# Must match the database name in DATABASE_URL
MYSQL_DATABASE=final_project_db

# MySQL User (non-root)
# Must match the user in DATABASE_URL
MYSQL_USER=appuser

# MySQL User Password
# Must match the password in DATABASE_URL
MYSQL_PASSWORD=apppass

# Optional: MySQL Configuration
MYSQL_PORT=3306
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
